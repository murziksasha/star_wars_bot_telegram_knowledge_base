{
  "name": "sw-codex-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Star Wars catalog Telegram bot (SWAPI + Fastify + Vercel)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=src/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "webhook:set": "tsx src/scripts/set-webhook.ts",
    "webhook:delete": "tsx src/scripts/delete-webhook.ts",
    "smoke:swapi": "tsx src/scripts/smoke-swapi.ts",
    "c4:render": "node SPEC/c4/render.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "fastify": "^5.6.0",
    "grammy": "^1.38.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
