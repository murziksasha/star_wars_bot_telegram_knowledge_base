# Telegram bot token from @BotFather (BOT_TOKEN is also accepted)
TELEGRAM_BOT_TOKEN=

# Required in production webhook mode. Random string, 1–256 chars.
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS origin of the Vercel deployment (no trailing slash)
PUBLIC_BASE_URL=https://your-app.vercel.app

SWAPI_BASE_URL=https://swapi.online

# local | production
NODE_ENV=development
PORT=3000
